<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><LangVersion>10.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <CounterHudSource Condition="'$(CounterHudSource)' == ''">../../KillCounterHud.cs</CounterHudSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(CounterHudSource)" Link="KillCounterHud.cs" />
    <Compile Include="../../KillCounterPolicy.cs" Link="KillCounterPolicy.cs" />
    <Compile Include="../../KillCounterAnchorPolicy.cs" Link="KillCounterAnchorPolicy.cs" />
  </ItemGroup>
</Project>
