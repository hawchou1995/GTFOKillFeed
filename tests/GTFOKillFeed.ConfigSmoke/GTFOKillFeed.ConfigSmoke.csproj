<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GTFO_DIR Condition="'$(GTFO_DIR)' == ''">C:\Program Files (x86)\Steam\steamapps\common\GTFO</GTFO_DIR>
  </PropertyGroup>
  <ItemGroup>
    <!-- Real BepInEx configuration engine: this project proves the hot-reload end to end through
         BepInEx's own ConfigFile, not through a re-implementation. -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(GTFO_DIR)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Compile Include="..\..\KillPolicy.cs" Link="KillPolicy.cs" />
    <Compile Include="..\..\FeedbackPolicy.cs" Link="FeedbackPolicy.cs" />
    <Compile Include="..\..\BarPolicy.cs" Link="BarPolicy.cs" />
    <Compile Include="..\..\TeammateMarkPolicy.cs" Link="TeammateMarkPolicy.cs" />
    <Compile Include="..\..\AssetReloadPolicy.cs" Link="AssetReloadPolicy.cs" />
    <Compile Include="..\..\ConfigHotReloadGate.cs" Link="ConfigHotReloadGate.cs" />
    <Compile Include="..\..\CardPresentation.cs" Link="CardPresentation.cs" />
    <Compile Include="..\..\HitSoundPolicy.cs" Link="HitSoundPolicy.cs" />
    <Compile Include="..\..\DamageFxPolicy.cs" Link="DamageFxPolicy.cs" />
    <Compile Include="..\..\FocusOutlinePolicy.cs" Link="FocusOutlinePolicy.cs" />
    <Compile Include="..\..\HitMarkerPolicy.cs" Link="HitMarkerPolicy.cs" />
    <Compile Include="..\..\KillIconPolicy.cs" Link="KillIconPolicy.cs" />
    <Compile Include="..\..\CorpseSwitches.cs" Link="CorpseSwitches.cs" />
    <Compile Include="..\..\KillViewPolicy.cs" Link="KillViewPolicy.cs" />
    <Compile Include="..\..\KillViewConfigApply.cs" Link="KillViewConfigApply.cs" />
    <Compile Include="..\..\CfgPresence.cs" Link="CfgPresence.cs" />
    <Compile Include="..\..\SoundSettings.cs" Link="SoundSettings.cs" />
    <Compile Include="..\..\SoundConfigPlan.cs" Link="SoundConfigPlan.cs" />
    <Compile Include="..\..\SoundConfigBinding.cs" Link="SoundConfigBinding.cs" />
  </ItemGroup>
</Project>
