    <EmbeddedResource Include="..\..\Assets\EnemyNames.defaults.json" LogicalName="KillFeed.EnemyNames.defaults.json" />
    <!-- The shipped marker set is asserted pixel for pixel, so the test assembly embeds the same files. -->
    <EmbeddedResource Include="..\..\Assets\icons\hitmark-*.png" LogicalName="KillFeed.Icons.%(Filename)%(Extension)" />
    <!-- The shipped cue set is asserted byte for byte, so the test assembly embeds the same files. -->
    <EmbeddedResource Include="..\..\Assets\audio\*.wav" LogicalName="KillFeed.Audio.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
