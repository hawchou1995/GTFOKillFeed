<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KillFeed.Policy.Tests</AssemblyName>
    <GTFO_DIR Condition="'$(GTFO_DIR)' == ''">C:\Program Files (x86)\Steam\steamapps\common\GTFO</GTFO_DIR>
  </PropertyGroup>
  <ItemGroup>
    <!-- Upstream (1.2.17) policy suite, linked against the hand-written tree: the three sources below are
         verbatim copies of the same files the company build compiles into the plugin. -->
    <Compile Include="..\..\KillViewPolicy.cs" Link="KillViewPolicy.cs" />
    <Compile Include="..\..\KillOccluderRecovery.cs" Link="KillOccluderRecovery.cs" />
    <Compile Include="..\..\KillViewConfigApply.cs" Link="KillViewConfigApply.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GTFO_DIR)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>