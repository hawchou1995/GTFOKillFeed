<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <MonoCecilPath Condition="'$(MonoCecilPath)' == '' and '$(GTFO_DIR)' != ''">$(GTFO_DIR)\BepInEx\core\Mono.Cecil.dll</MonoCecilPath>
  </PropertyGroup>
  <Target Name="RequireMonoCecil" BeforeTargets="ResolveAssemblyReferences" Condition="'$(MonoCecilPath)' == ''">
    <Error Text="MonoCecilPath is not set. Set MonoCecilPath or GTFO_DIR to a directory containing BepInEx/core/Mono.Cecil.dll." />
  </Target>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(MonoCecilPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
